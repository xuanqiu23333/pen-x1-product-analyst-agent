DEMO_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 已有工作流的生产数据开关保留；Sandbox 脚本不会启用它。
AMAZON_REAL_DATA_ENABLED=false

# 新配置统一使用 SP_API_*；代码仍可读取旧 AMAZON_* 名称以保持兼容。
SP_API_ENV=sandbox
SP_API_REGION=na
SP_API_ENDPOINT=https://sandbox.sellingpartnerapi-na.amazon.com
SP_API_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
SP_API_LWA_CLIENT_ID=
SP_API_LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_API_MARKETPLACE_ID_US=ATVPDKIKX0DER
SP_API_MARKETPLACE_ID_CA=A2EUQ1WTGCTBG2
SP_API_DEFAULT_MARKETPLACE_ID=ATVPDKIKX0DER
SP_API_TIMEOUT=30
SP_API_MAX_RETRIES=3
SP_API_TOKEN_REFRESH_BUFFER_SECONDS=300
