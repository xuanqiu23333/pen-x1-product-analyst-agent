DEMO_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 已有工作流的生产数据开关保留；Sandbox 脚本不会启用它。
AMAZON_REAL_DATA_ENABLED=false

# 新配置统一使用 SP_API_*；代码仍可读取旧 AMAZON_* 名称以保持兼容。
SP_API_ENV=sandbox
SP_API_REGION=na
SP_API_ENDPOINT=https://sandbox.sellingpartnerapi-na.amazon.com
SP_API_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
SP_API_LWA_CLIENT_ID=
SP_API_LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_API_MARKETPLACE_ID_US=ATVPDKIKX0DER
SP_API_MARKETPLACE_ID_CA=A2EUQ1WTGCTBG2
SP_API_DEFAULT_MARKETPLACE_ID=ATVPDKIKX0DER
SP_API_TIMEOUT=30
SP_API_MAX_RETRIES=3
SP_API_TOKEN_REFRESH_BUFFER_SECONDS=300

# Bright Data Amazon Reviews Scraper API。真实 Token 只能写入未跟踪的 .env。
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_AMAZON_REVIEWS_DATASET_ID=gd_le8e811kzy4ggddlq
BRIGHTDATA_REVIEW_TARGET_PER_PRODUCT=100
BRIGHTDATA_API_TIMEOUT=60
BRIGHTDATA_POLL_INTERVAL_SECONDS=5
BRIGHTDATA_MAX_POLL_SECONDS=180
BRIGHTDATA_MAX_RETRIES=3
# 完成并人工检查一款商品 5 条 Schema Probe 后才能改为 true。
BRIGHTDATA_SCHEMA_CONFIRMED=false

# 真实评论采集 Provider：APIFY（默认）或 BRIGHTDATA。
REVIEW_COLLECTION_PROVIDER=APIFY
APIFY_API_TOKEN=
APIFY_AMAZON_REVIEWS_ACTOR=kestrel/amazon-reviews-scraper
# 历史兼容配置：该 Actor 要求付费用户，本项目免费模式不启用。
APIFY_LEGACY_AMAZON_REVIEWS_ACTOR=axesso_data/amazon-reviews-scraper
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_REVIEW_TARGET_PER_PRODUCT=100
APIFY_API_TIMEOUT=60
APIFY_POLL_INTERVAL_SECONDS=5
APIFY_MAX_POLL_SECONDS=180
